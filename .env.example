# Copy to .env (or .env.local) and fill in. Never commit the real file.

# Postgres with the pgvector extension (docker compose up -d gives you this)
DATABASE_URL=postgres://triagedesk:triagedesk@localhost:5433/triagedesk

# Long random string used to sign session tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Embeddings: "local" runs all-MiniLM-L6-v2 on your machine (downloads ~25 MB once).
# "hash" is an offline fallback for testing only; similarity results will be poor.
EMBEDDING_PROVIDER=local
